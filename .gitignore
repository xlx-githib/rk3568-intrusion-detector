# ---- 构建产物 ----
build/
*.o
*.a
*.so
*.elf
*.out

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*~

# ---- 运行时产物（板端/PC 端生成的日志与截图，不入库）----
logs/
shots/

# ---- 模型文件较大，默认不入库（小模型可自行决定，或改用 Git LFS）----
*.rknn
models/*.onnx

# ---- Python (host 上位机) ----
__pycache__/
*.pyc
host/.venv/

# ---- Qt 构建产物 (host/qt_gui) ----
host/qt_gui/Makefile*
host/qt_gui/.qmake.stash
host/qt_gui/*.pro.user
host/qt_gui/release/
host/qt_gui/debug/

# ---- 板端临时抽帧/预览图(本机查看用，不入库) ----
tools/board/*.rgb
tools/board/*.ppm
tools/board/*.png
